{
  "build": {
    "context": "backend",
    "dockerfilePath": "Dockerfile.celery"
  },
  "deploy": {
    "startCommand": "celery -A core worker --loglevel=info",
    "healthcheckPath": "/health/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
