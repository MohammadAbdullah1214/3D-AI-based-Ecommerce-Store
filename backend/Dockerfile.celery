FROM ubuntu:22.04

# Install dependencies
RUN apt-get update && \
    apt-get install -y wget python3 python3-pip libgl1-mesa-glx curl && \
    rm -rf /var/lib/apt/lists/*

# Install Blender (headless) - optimized for size
ENV BLENDER_VERSION=4.0.2
RUN wget https://download.blender.org/release/Blender${BLENDER_VERSION%.*}/blender-${BLENDER_VERSION}-linux-x64.tar.xz && \
    tar -xf blender-${BLENDER_VERSION}-linux-x64.tar.xz && \
    mv blender-${BLENDER_VERSION}-linux-x64 /opt/blender && \
    ln -s /opt/blender/blender /usr/local/bin/blender && \
    rm blender-${BLENDER_VERSION}-linux-x64.tar.xz && \
    # Remove unnecessary Blender files to reduce size
    rm -rf /opt/blender/4.0/python/lib/python3.10/site-packages/numpy/tests && \
    rm -rf /opt/blender/4.0/python/lib/python3.10/site-packages/scipy/tests && \
    rm -rf /opt/blender/4.0/python/lib/python3.10/site-packages/matplotlib/tests && \
    rm -rf /opt/blender/4.0/python/lib/python3.10/site-packages/pandas/tests && \
    find /opt/blender -name "*.pyc" -delete && \
    find /opt/blender -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# Copy code
WORKDIR /app
COPY requirements-celery.txt .
RUN pip3 install --upgrade pip && \
    pip3 install --no-cache-dir -r requirements-celery.txt && \
    rm -rf ~/.cache/pip
COPY . .

# Set environment variable for Django
ENV DJANGO_SETTINGS_MODULE=core.settings

# Expose port for health checks
EXPOSE 8000

# Create a startup script
RUN echo '#!/bin/bash\n\
# Start Django server for health checks\n\
python3 manage.py runserver 0.0.0.0:8000 &\n\
DJANGO_PID=$!\n\
\n\
# Start Celery worker\n\
celery -A core worker --loglevel=info &\n\
CELERY_PID=$!\n\
\n\
# Wait for either process to exit\n\
wait $DJANGO_PID $CELERY_PID\n\
' > /app/start.sh && chmod +x /app/start.sh

CMD ["/app/start.sh"]
